{
  "name": "walking-trudy",
  "version": "0.1.0",
  "private": true,
  "description": "Trudy the Corgi office dog's walk/potty/crate bot for Corgi Relay (Telegram Bot API compatible), running on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply walking-trudy --local",
    "db:migrate:remote": "wrangler d1 migrations apply walking-trudy --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
